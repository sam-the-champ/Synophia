# Canonical list of environment variables for the synophia web app.
# Copy to .env.local and fill in real values. Never commit .env.local.
# Client-safe values are prefixed NEXT_PUBLIC_; everything else is server-only.

# --- Clerk (authentication) ---
# Publishable key is safe to expose to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key is server-only. Never expose to the client, never commit.
CLERK_SECRET_KEY=

# Where Clerk's hosted sign-in / sign-up routes live in this app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Sanity (content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-14
# Server-only read token (Viewer role) for the private dataset.
# Never expose to the client, never commit.
SANITY_API_READ_TOKEN=
